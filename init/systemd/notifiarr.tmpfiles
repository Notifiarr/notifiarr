# systemd-tmpfiles.d — config and log dirs for User=notifiarr (see notifiarr.service).
# /etc/notifiarr stays root:notifiarr. systemd refuses a notifiarr-owned directory
# that still contains root-owned package files ("unsafe path transition").
# Group write lets the daemon create backups/ and replace the config.
d /etc/notifiarr 0775 root notifiarr -
d /var/log/notifiarr 0755 notifiarr notifiarr -
z /etc/notifiarr 0775 root notifiarr -
z /var/log/notifiarr 0755 notifiarr notifiarr -
