# Claim packaged config paths on first install. post_upgrade is a no-op: an
# admin who overrode User=/Group= has already chowned away from root.
# Name the packaged files instead of chown -R so extra files keep their owner.
# Always return 0 so a missing example file cannot fail the pacman transaction.
post_install() {
  if command -v systemd-sysusers >/dev/null; then
    systemd-sysusers notifiarr.conf || true
  fi
  if [ -d /etc/notifiarr ]; then
    chown notifiarr:notifiarr /etc/notifiarr || true
    if [ -f /etc/notifiarr/notifiarr.conf ]; then
      chown notifiarr:notifiarr /etc/notifiarr/notifiarr.conf || true
    fi
    if [ -f /etc/notifiarr/notifiarr.conf.example ]; then
      chown notifiarr:notifiarr /etc/notifiarr/notifiarr.conf.example || true
    fi
  fi
  return 0
}

post_upgrade() {
  :
}
