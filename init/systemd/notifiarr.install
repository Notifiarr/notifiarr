# Fresh install only. Upgrades must not reset config ownership for admins
# who overrode User=/Group= in a systemd drop-in.
post_install() {
  if command -v systemd-sysusers >/dev/null; then
    systemd-sysusers notifiarr.conf
  fi
  if [ -d /etc/notifiarr ]; then
    chown -R notifiarr:notifiarr /etc/notifiarr
  fi
}

post_upgrade() {
  :
}
